# LamarKerja AI - Backend Environment
PORT=5000
NODE_ENV=development

# PostgreSQL lokal:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lamarkerja
# Supabase: Session pooler port 5432 (bukan 6543) + sslmode=require
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Groq Cloud AI API Key — https://console.groq.com/keys
GROQ_API_KEY=

# JWT Authentication Secret (ganti di production)
JWT_SECRET=ganti_dengan_secret_acak

# Frontend origin untuk CORS (Vercel production, koma jika lebih dari satu)
# CLIENT_URL=https://lamarkerja.vercel.app
# Optional. Railway (Root Directory = server): mount volume at /app/uploads
# UPLOAD_DIR=/app/uploads
CLIENT_URL=http://localhost:3000
